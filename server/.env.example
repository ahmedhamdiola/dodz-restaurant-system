# Copy this file to .env and fill in your own values. Never commit your real .env.

PORT=4000
CLIENT_URL=http://localhost:5173
BASE_URL=/api/v1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=dodz_restaurant
DB_USER=dodz
DB_PASSWORD=change-me

# At least 32 characters. Keep it secret — it signs every auth JWT.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional — used by `npm run create:admin`
ADMIN_NAME=DODZ Admin
ADMIN_EMAIL=admin@dodz.example
ADMIN_PASSWORD=change-me-please